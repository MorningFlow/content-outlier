# Content Outlier Environment Configuration

# Application
APP_ENV=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=content-outlier-dev-secret-key-32chars-min

# Database (PostgreSQL)
# Format: postgresql+psycopg://username:password@localhost:5432/content_outlier
# Defaults to SQLite in development if DATABASE_URL is not set or empty
DATABASE_URL=sqlite:///./content_outlier.db
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/content_outlier

# Storage Provider ('local' or 's3')
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./media_storage
# S3 / Cloudflare R2 Settings (if STORAGE_BACKEND=s3)
S3_ENDPOINT_URL=
S3_BUCKET_NAME=content-outlier-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION_NAME=auto
S3_PUBLIC_BASE_URL=

# Instagram Scraper Settings
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
INSTAGRAM_SESSION_FILE=
MAX_REELS_PER_SCRAPE=50
SCRAPE_DELAY_SECONDS=3.5
RATE_LIMIT_BACKOFF_MINUTES=60

# Outlier Intelligence Weights
OUTLIER_MIN_BASELINE_POSTS=3
OUTLIER_VIEW_MULTIPLIER_WEIGHT=0.60
OUTLIER_ENGAGEMENT_WEIGHT=0.25
OUTLIER_VELOCITY_WEIGHT=0.15
OUTLIER_THRESHOLD_MULTIPLIER=3.0

# Worker Settings
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL=5.0
DEFAULT_SCAN_INTERVAL_HOURS=6
AUTO_DOWNLOAD_OUTLIERS=true
AUTO_TRANSCRIBE_OUTLIERS=true
